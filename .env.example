# Optional: override demo login (defaults: ultron@acko.com / Ultron#2026)
# VITE_ULTRON_EMAIL=you@company.com
# VITE_ULTRON_PASSWORD=your-secret

# Server-only OpenAI key — used by Vercel `/api/openai` proxy and Vite dev proxy (NOT exposed to browser).
# Local: set in `.env.local` as OPENAI_API_KEY=sk-...
# Vercel: Project → Settings → Environment Variables → OPENAI_API_KEY
# OPENAI_API_KEY=

# Optional: image model for AI hero. Default is gpt-image-2 (GPT Image 2). Example: dall-e-3
# VITE_OPENAI_IMAGE_MODEL=gpt-image-2

# Optional: Freepik API key — legacy hero path (local/dev only if used).
# VITE_FREEPIK_API_KEY=

# Optional: for `vite preview` only — use same-origin proxy like dev for Freepik.
# VITE_FREEPIK_USE_DEV_PROXY=true

# Optional: Google Sign-In (GIS token client) — “Continue with Google” on the login screen.
# VITE_GOOGLE_CLIENT_ID=
# Optional alias for the same value:
# VITE_GOOGLE_OAUTH_CLIENT_ID=
