# Optional: override demo login (defaults: ultron@acko.com / Ultron#2026)
# VITE_ULTRON_EMAIL=you@company.com
# VITE_ULTRON_PASSWORD=your-secret

# Optional: Freepik API key — AI hero visual (text-to-image). Local/dev; key is in the client bundle.
# VITE_FREEPIK_API_KEY=

# Optional: for `vite preview` only — use same-origin proxy like dev (set true, then npm run build && npm run preview).
# VITE_FREEPIK_USE_DEV_PROXY=true

# Optional: OpenAI API key — GPT Image hero + V2 chat (local/dev; exposed in client bundle).
# VITE_OPENAI_API_KEY=

# Optional: image model for AI hero. Default is gpt-image-1 (GPT Image 1). Example: dall-e-3
# VITE_OPENAI_IMAGE_MODEL=gpt-image-1

# Optional: for `vite preview` only — same-origin proxy like dev (set true, then npm run build && npm run preview).
# VITE_OPENAI_USE_DEV_PROXY=true

# Optional: Google Sign-In (GIS token client) — “Continue with Google” on the login screen.
# VITE_GOOGLE_CLIENT_ID=
# Optional alias for the same value:
# VITE_GOOGLE_OAUTH_CLIENT_ID=
